{
  "name": "league-platform-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "api:generate": "openapi-generator-cli generate -i ../api/openapi.yaml -g typescript-angular -o src/app/api --additional-properties=providedInRoot=true",
    "start": "npm run api:generate && ng serve --configuration local",
    "start:mock": "npm run api:generate && ng serve --configuration mock",
    "build": "npm run api:generate && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run api:generate && ng test --watch=false"
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@openapitools/openapi-generator-cli": "^2.42.2",
    "@types/node": "^24.19.2",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
